GEMINI_API_KEY=
PIPEWRIGHT_ENCRYPTION_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# ─────────────────────────────────────────────────────────────────────────────
# Role-based LLM configuration (optional)
# See docs/llm/role-based-configuration.md and docs/llm/provider-matrix.md
#
# Resolution per role: <ROLE>_LLM_* -> DEFAULT_LLM_* -> gemini/gemini-2.5-flash-lite
# Leave everything below unset to run all roles on the Gemini default.
# ─────────────────────────────────────────────────────────────────────────────

# Additional provider API keys (only needed if a role uses that provider)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=

# Default provider/model used by every role without an explicit override
# DEFAULT_LLM_PROVIDER=gemini
# DEFAULT_LLM_MODEL=gemini-2.5-flash-lite

# Per-role overrides. Roles: triage, planner, coder, summary
# (reviewer and architect are accepted but not yet wired into the pipeline)
# TRIAGE_LLM_PROVIDER=
# TRIAGE_LLM_MODEL=
# PLANNER_LLM_PROVIDER=
# PLANNER_LLM_MODEL=
# CODER_LLM_PROVIDER=
# CODER_LLM_MODEL=
# SUMMARY_LLM_PROVIDER=
# SUMMARY_LLM_MODEL=
# REVIEWER_LLM_PROVIDER=
# REVIEWER_LLM_MODEL=
# ARCHITECT_LLM_PROVIDER=
# ARCHITECT_LLM_MODEL=
